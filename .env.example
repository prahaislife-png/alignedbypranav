# ------------------------------------------------------------------
# Aligned by Pranav – environment variables
# Copy to .env.local for local development (never commit .env.local).
# In Vercel: Project → Settings → Environment Variables.
# Every value is optional: the site always builds, and missing values
# are handled safely. NEXT_PUBLIC_* values are read at build time, so
# redeploy after changing them.
# ------------------------------------------------------------------

# Canonical site address, no trailing slash. Used for canonical URLs, the
# sitemap and social images. If empty on Vercel, the project's production
# domain is used automatically.
# Example: https://www.alignedbypranav.com
NEXT_PUBLIC_SITE_URL=

# WhatsApp Business number in international format, country code first.
# Spaces, dashes and a leading + are fine. Example: +91 98765 43210
# If empty or invalid, every WhatsApp button points to the Contact page instead.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional public contact email shown on the Contact page and legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional social profile links (must start with https://).
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Optional analytics. Nothing loads until a visitor consents.
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Meta (Facebook/Instagram) Pixel ID – digits only.
NEXT_PUBLIC_META_PIXEL_ID=
# Set to "true" after enabling Web Analytics in the Vercel dashboard.
NEXT_PUBLIC_VERCEL_ANALYTICS=false
